---
import { strings, type Lang } from "../i18n/strings";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = strings[lang].services;
---

<section class="services" id="hizmetler">
  <div class="wrap">
    <div class="head">
      <div>
        <p class="eyebrow">{t.eyebrow}</p>
        <h2>{t.heading}</h2>
      </div>
      <p class="intro">{t.intro}</p>
    </div>

    <div class="cards">
      {t.items.map((s) => (
        <article class="card" id={s.num === "01" ? "egitim" : undefined}>
          <div class="card-head">
            <span class="num">{s.num}</span>
            <h3>{s.title}</h3>
          </div>
          {"list" in s ? (
            <ul class="tlist">
              {s.list.map((item) => <li>{item}</li>)}
            </ul>
          ) : (
            <>
              <p class="quote">“{s.quote}”</p>
              <div class="body">
                {s.body.map((p) => <p>{p}</p>)}
              </div>
            </>
          )}
          <div class="card-foot">
            <span class="format">{t.format}</span>
            <a href="#iletisim">{t.cardCta}</a>
          </div>
        </article>
      ))}
    </div>

    <p class="caption">{t.caption}</p>
  </div>
</section>

<style>
  .services { padding-block: 5rem; background: var(--bg); }

  .head {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 2rem;
    align-items: end;
    margin-bottom: 1.6rem;
  }

  .intro { font-size: 1.05rem; color: var(--fg-soft); max-width: 480px; }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    background: var(--card);
    color: var(--card-fg);
    padding: 1.8rem 1.6rem 1.5rem;
    border-top: 3px solid var(--accent);
  }

  .card-head { display: flex; align-items: baseline; gap: 0.7rem; }

  .num {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: #12A594;
  }

  h3 { font-size: 1.3rem; }

  .quote {
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: #12A594;
  }

  .tlist {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 0.5px solid rgba(10, 10, 10, 0.2);
  }

  .tlist li {
    padding: 0.7rem 0;
    border-bottom: 0.5px solid rgba(10, 10, 10, 0.2);
    font-size: 0.92rem;
    font-weight: 700;
    line-height: 1.35;
  }

  .tlist li:last-child { border-bottom: 0; }

  .body { display: grid; gap: 0.6rem; }
  .body p { font-size: 0.95rem; line-height: 1.55; }

  .card-foot {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding-top: 0.9rem;
    border-top: 0.5px solid rgba(10, 10, 10, 0.2);
  }

  .format { font-size: 0.78rem; font-weight: 600; }

  .card-foot a {
    font-size: 0.92rem;
    font-weight: 800;
    text-decoration: none;
    color: var(--color-ink);
  }

  .card-foot a:hover { color: #12A594; }

  .caption { margin-top: 1.5rem; font-size: 0.92rem; color: var(--fg-soft); }

  @media (max-width: 1000px) {
    .cards { grid-template-columns: 1fr; }
  }

  @media (max-width: 900px) {
    .services { padding-block: 3.5rem; }
    .head { grid-template-columns: 1fr; gap: 0.8rem; }
  }
</style>
