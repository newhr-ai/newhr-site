---
import { strings, linkedin, type Lang } from "../i18n/strings";

interface Props { lang?: Lang }
const { lang = "tr" } = Astro.props;
const t = strings[lang].footer;
const n = strings[lang].nav;
const home = lang === "en" ? "/en/" : "/";
const resourcesHref = lang === "en" ? "/en/downloads/" : "/downloads/";
const privacyHref = lang === "en" ? "/en/privacy/" : "/privacy/";
const logo = "/logos/newhr_ai_logo_horizontal_dark.png";
---

<footer class="footer">
  <div class="wrap grid">
    <div class="brand">
      <img src={logo} alt="New HR AI" class="logo" loading="lazy" />
      <p class="tagline">{t.tagline}</p>
    </div>
    <div class="col">
      <p class="label">{t.pages}</p>
      <a href={home}>{t.home}</a>
      <a href={`${home}#hizmetler`}>{n.services}</a>
      <a href={`${home}#yaklasim`}>{n.approach}</a>
      <a href={`${home}#referanslar`}>{n.refs}</a>
      <a href={`${home}#hakkinda`}>{n.about}</a>
      <a href={resourcesHref}>{t.resources}</a>
    </div>
    <div class="col">
      <p class="label">{t.contactLabel}</p>
      <a href="mailto:hello@newhr.ai">hello@newhr.ai</a>
      <a href={linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a href={privacyHref}>{t.privacy}</a>
    </div>
  </div>
  <div class="wrap bottom">
    <span>{t.copyright}</span>
    <span>{t.mantra}</span>
  </div>
</footer>

<style>
  .footer {
    background: #0A0A0A;
    color: #fff;
    padding-block: 3rem 1.5rem;
  }

  .grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: 2rem;
    padding-bottom: 2rem;
    border-bottom: 0.5px solid rgba(255,255,255,0.2);
  }

  .logo { height: 28px; width: auto; margin-bottom: 0.8rem; }
  .tagline { font-size: 0.9rem; font-weight: 700; }

  .label {
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #5DE3D3;
    margin-bottom: 0.7rem;
  }

  .col { display: flex; flex-direction: column; gap: 0.4rem; }
  .col a { color: #fff; text-decoration: none; font-size: 0.92rem; }
  .col a:hover { color: #5DE3D3; }

  .bottom {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-top: 1.2rem;
    font-size: 0.8rem;
  }

  @media (max-width: 700px) {
    .grid { grid-template-columns: 1fr; gap: 1.5rem; }
  }
</style>
