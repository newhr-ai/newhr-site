---
import { strings, linkedin, type Lang } from "../i18n/strings";

interface Props { lang?: Lang }
const { lang = "tr" } = Astro.props;
const t = strings[lang].footer;
const home = lang === "en" ? "/en/" : "/";
const resourcesHref = lang === "en" ? "/en/downloads/" : "/downloads/";
const privacyHref = lang === "en" ? "/en/privacy/" : "/privacy/";
// TR: logo + tagline line from the kit. EN: the kit has no English tagline
// artwork yet, so the plain footer logo is used.
const line = lang === "en" ? "/logos/newhrai-footer-logo_for-dark-bg.svg" : "/logos/newhrai-footer-line_for-dark-bg.svg";
const lineWidth = lang === "en" ? 200 : 460;
---

<footer class="footer">
  <div class="wrap">
    <div class="line">
      <a href={home} aria-label="newhr.ai"><img src={line} alt={t.sloganAlt} style={`width:min(100%, ${lineWidth}px)`} loading="lazy" /></a>
    </div>

    <div class="grid">
      <nav class="links" aria-label="footer">
        <a href={`${home}#hizmetler`}>{t.services}</a>
        <a href={`${home}#hakkinda`}>{t.about}</a>
        <a href={resourcesHref}>{t.resources}</a>
      </nav>
      <div class="contact">
        <a href="mailto:hello@newhr.ai">hello@newhr.ai</a>
        <a href={linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
      </div>
    </div>

    <div class="bottom">
      <span>{t.copyright}</span>
      <a href={privacyHref}>{t.privacy}</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: #0A0A0A;
    color: #fff;
    padding-block: 3rem 1.5rem;
  }

  .line {
    padding-bottom: 2rem;
    margin-bottom: 2rem;
    border-bottom: 0.5px solid rgba(255, 255, 255, 0.2);
  }

  .line img { display: block; height: auto; }

  .grid {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2rem;
    align-items: center;
    padding-bottom: 2rem;
    border-bottom: 0.5px solid rgba(255, 255, 255, 0.2);
  }

  .links {
    display: flex;
    gap: 1.6rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .contact { display: flex; flex-direction: column; gap: 0.4rem; align-items: flex-end; }

  .footer a { color: #fff; text-decoration: none; font-size: 0.92rem; }
  .footer a:hover { color: #5DE3D3; }

  .bottom {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-top: 1.2rem;
    font-size: 0.8rem;
  }

  .bottom a { font-size: 0.8rem; }

  @media (max-width: 700px) {
    .grid { grid-template-columns: 1fr; gap: 1.2rem; }
    .links { justify-content: flex-start; }
    .contact { align-items: flex-start; }
  }
</style>
