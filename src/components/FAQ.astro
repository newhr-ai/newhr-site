---
import { strings, type Lang } from "../i18n/strings";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = strings[lang].faq;
---

<section class="faq" id="sss">
  <div class="wrap grid">
    <div class="head">
      <p class="eyebrow">{t.eyebrow}</p>
      <h2>{t.heading}</h2>
    </div>
    <div class="items">
      {t.items.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq { padding-block: 5rem; background: var(--bg); }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 3rem;
    align-items: start;
  }

  h2 { font-size: clamp(1.7rem, 3.2vw, 2.4rem); }

  details { border-top: 0.5px solid var(--line-strong); }
  details:last-child { border-bottom: 0.5px solid var(--line-strong); }

  summary {
    cursor: pointer;
    list-style: none;
    padding: 1.1rem 2rem 1.1rem 0;
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    position: relative;
  }

  summary::-webkit-details-marker { display: none; }

  summary::after {
    content: "+";
    position: absolute;
    right: 0.2rem;
    top: 0.95rem;
    font-size: 1.4rem;
    font-weight: 500;
    color: var(--accent-text);
  }

  details[open] summary::after { content: "–"; }

  details p { padding: 0 2rem 1.2rem 0; max-width: 620px; }

  @media (max-width: 800px) {
    .faq { padding-block: 3.5rem; }
    .grid { grid-template-columns: 1fr; gap: 1.5rem; }
  }
</style>
