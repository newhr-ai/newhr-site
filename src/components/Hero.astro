---
import { strings, type Lang } from "../i18n/strings";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = strings[lang].hero;
---

<section class="hero">
  <div class="wrap">
    <div class="hero-text">
      <h1>{t.titleLine1}{" "}<br />{t.titleLine2}</h1>
      <p class="lead">{t.lead}</p>
      <a href="#iletisim" class="btn">{t.cta}</a>
    </div>

    <nav class="deck" aria-label={t.cardsLabel}>
      {t.cards.map((c) => (
        <a href="#hizmetler">
          <img src={c.img} alt="" width="1200" height="900" loading="eager" decoding="async" />
          <span>{c.title} <i>{c.num}</i></span>
        </a>
      ))}
    </nav>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--bg);
    padding-block: 7rem 2.5rem;
    text-align: center;
  }

  .hero-text {
    max-width: 880px;
    margin: 0 auto 2.2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  h1 {
    font-size: clamp(2rem, 4vw, 3.1rem);
    font-weight: 800;
    color: #fff;
    margin-bottom: 1rem;
    text-wrap: pretty;
  }

  .lead {
    font-size: clamp(1rem, 1.3vw, 1.15rem);
    font-weight: 500;
    color: #fff;
    max-width: 600px;
    margin-bottom: 1.5rem;
  }

  .btn { font-size: 1rem; padding: 0.95rem 1.6rem; }

  /* Three service cards, fanned. Hover/focus lifts one and dims the others. */
  .deck {
    position: relative;
    height: 330px;
    width: min(100%, 720px);
    margin: 0 auto;
    text-align: left;
  }

  .deck a {
    position: absolute;
    left: 0;
    top: 0;
    width: 250px;
    background: #F8F8F5;
    color: var(--color-ink);
    text-decoration: none;
    padding: 0.4rem 0.4rem 0.6rem;
    box-shadow: 0 24px 50px -28px rgba(0, 0, 0, 0.9);
    transform: translate(var(--x), var(--y)) rotate(var(--r));
    transition: transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.45s ease, opacity 0.45s ease, filter 0.45s ease;
    will-change: transform;
  }

  .deck a img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .deck a span {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.55rem 0.3rem 0;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .deck a span i {
    font-style: normal;
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: #12A594;
  }

  .deck a:nth-child(1) { --x: 0px;   --y: 34px; --r: -6deg; z-index: 1; }
  .deck a:nth-child(2) { --x: 235px; --y: 0px;  --r: 0deg;  z-index: 2; }
  .deck a:nth-child(3) { --x: 470px; --y: 34px; --r: 6deg;  z-index: 3; }

  .deck:hover a,
  .deck:focus-within a { opacity: 0.55; filter: saturate(0.6); }

  .deck a:hover,
  .deck a:focus-visible {
    opacity: 1;
    filter: none;
    transform: translate(var(--x), calc(var(--y) - 34px)) rotate(0deg) scale(1.1);
    z-index: 10;
    box-shadow: 0 50px 80px -30px rgba(0, 0, 0, 1), 0 0 0 1px rgba(93, 227, 211, 0.35);
    outline: none;
  }

  .deck a:focus-visible { box-shadow: 0 0 0 3px var(--accent); }

  @media (prefers-reduced-motion: reduce) {
    .deck a { transition: none; }
  }

  @media (max-width: 900px) {
    .hero { padding-block: 3rem 2rem; }
    h1 br { display: none; }
    .deck {
      height: auto;
      width: 100%;
      display: flex;
      gap: 0.8rem;
      overflow-x: auto;
      padding: 0.5rem 0.2rem 1rem;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
    }
    .deck a { position: static; flex: 0 0 220px; transform: none; scroll-snap-align: start; }
    .deck:hover a, .deck:focus-within a { opacity: 1; filter: none; }
    .deck a:hover { transform: none; }
  }

  @media (max-width: 700px) {
    h1 { font-size: clamp(1.9rem, 8vw, 2.4rem); }
  }
</style>
