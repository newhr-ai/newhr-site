---
import { strings, assessmentPath, type Lang } from "../i18n/strings";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = strings[lang].assessment;
---

<section class="assess" id="degerlendirme">
  <div class="wrap box">
    <div class="text">
      <p class="eyebrow">{t.eyebrow}</p>
      <h2>{t.heading}</h2>
      <p class="body">{t.body}</p>
    </div>
    <div class="side">
      <a href={assessmentPath(lang)} class="btn-ghost">{t.cta}</a>
      <p class="note">{t.note}</p>
    </div>
  </div>
</section>

<style>
  .assess { padding-block: 3.5rem; background: var(--bg); }

  .box {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 2.5rem;
    align-items: center;
    padding: 2.5rem 0;
    border-top: 0.5px solid var(--line-strong);
    border-bottom: 0.5px solid var(--line-strong);
  }

  h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); margin-bottom: 0.8rem; }
  .body { max-width: 560px; }

  .side { display: flex; flex-direction: column; align-items: flex-start; gap: 0.7rem; }
  .note { font-size: 0.8rem; font-weight: 600; letter-spacing: 0.04em; color: var(--accent-text); }

  @media (max-width: 800px) {
    .box { grid-template-columns: 1fr; gap: 1.4rem; padding: 2rem 0; }
    .assess { padding-block: 2.5rem; }
  }
</style>
