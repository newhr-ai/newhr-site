---
import { strings, type Lang } from "../i18n/strings";

interface Props { lang: Lang }
const { lang } = Astro.props;
const look = "cards";
const id = "yorumlar";
const t = strings[lang].quotes;

const meta = [
  { photo: "/images/testimonials/ilgi-karakus.jpg", link: "https://www.linkedin.com/feed/update/urn:li:share:7452763499388166145/" },
  { photo: "/images/testimonials/okan-tunali.jpg", link: "https://www.linkedin.com/feed/update/urn:li:share:7454552977052246016/" },
  { photo: "/images/testimonials/baris-ozkaner.jpg", link: "https://www.linkedin.com/feed/update/urn:li:share:7450832027731451905/" },
];
---

<section class={`quotes ${look}`} id={id}>
  <div class="wrap">
    <h2>{t.heading}</h2>

    <div class="grid">
      {t.items.map((q, i) => (
        <article class="q">
          <p class="sector">{q.sector}</p>
          <blockquote>“{q.quote}”</blockquote>
          <div class="foot">
            <div class="person">
              <img src={meta[i].photo} alt={q.name} width="48" height="48" loading="lazy" />
              <div>
                <p class="name">{q.name}</p>
                <p class="role">{q.role}</p>
              </div>
            </div>
            <a class="li" href={meta[i].link} target="_blank" rel="noopener noreferrer">{t.linkedin}</a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .quotes { padding-block: 5rem; background: var(--bg); }
  h2 { margin-bottom: 2.5rem; }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.2rem;
  }

  .q {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }

  .cards .q {
    background: var(--card);
    color: var(--card-fg);
    padding: 1.8rem 1.6rem;
    border-top: 2px solid var(--accent);
  }

  .editorial .grid { gap: 3rem; }

  .editorial .q {
    padding-top: 1.2rem;
    border-top: 2px solid var(--fg);
  }

  .sector {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .cards .sector { color: #1E9484; }
  .editorial .sector { color: var(--accent-text); }

  blockquote {
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.02em;
    flex: 1;
  }

  .editorial blockquote { font-size: 1.55rem; font-weight: 800; letter-spacing: -0.03em; }

  .foot {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    padding-top: 1rem;
    border-top: 0.5px solid rgba(10,10,10,0.2);
  }

  .editorial .foot { border-top-color: var(--line); }

  .person { display: flex; align-items: center; gap: 0.8rem; }

  img { width: 48px; height: 48px; border-radius: 50%; object-fit: cover; }

  .name { font-size: 0.95rem; font-weight: 800; line-height: 1.2; }
  .role { font-size: 0.85rem; line-height: 1.3; }

  .li {
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
    color: inherit;
    border-bottom: 1.5px solid var(--accent);
    align-self: flex-start;
  }

  @media (max-width: 900px) {
    .quotes { padding-block: 3.5rem; }
    .grid { grid-template-columns: 1fr; }
    .editorial .grid { gap: 1.8rem; }
    .editorial blockquote { font-size: 1.35rem; }
  }
</style>
