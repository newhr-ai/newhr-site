---
import { strings, type Lang } from "../i18n/strings";

interface Props { lang: Lang }
const { lang } = Astro.props;
const tone = "alt";
const t = strings[lang].approach;
---

<section class={`approach tone-${tone}`} id="yaklasim">
  <div class="wrap">
    <p class="eyebrow">{t.eyebrow}</p>
    <div class="head">
      <h2>{t.heading}</h2>
      <p class="intro">{t.intro}</p>
    </div>
    <ol class="steps">
      {t.steps.map((s) => (
        <li>
          <span class="num">{s.num}</span>
          <h3>{s.title}</h3>
          <p>{s.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .approach { padding-block: 5rem; }
  .tone-alt { background: var(--bg-alt); }
  .tone-plain { background: var(--bg); border-top: 0.5px solid var(--line); }

  .head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: end;
    margin-bottom: 3rem;
  }

  .intro { font-size: 1.05rem; max-width: 460px; }

  .steps {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  li {
    padding-top: 1.2rem;
    border-top: 2px solid var(--accent);
  }

  .num {
    display: block;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    color: var(--accent-text);
    margin-bottom: 0.7rem;
  }

  h3 { font-size: 1.7rem; margin-bottom: 0.7rem; }
  li p { font-size: 0.98rem; }

  @media (max-width: 900px) {
    .approach { padding-block: 3.5rem; }
    .head { grid-template-columns: 1fr; gap: 0.8rem; margin-bottom: 2rem; }
    .steps { grid-template-columns: 1fr; gap: 1.5rem; }
  }
</style>
