---
import { strings, mailto, type Lang } from "../i18n/strings";

interface Props {
  lang?: Lang;
}

const { lang = "tr" } = Astro.props;
const trHref = "/";
const enHref = "/en/";
const t = strings[lang].nav;
const home = lang === "en" ? enHref : trHref;
const resourcesHref = lang === "en" ? "/en/downloads/" : "/downloads/";
const cta = t.cta;
---

<header class="nav">
  <div class="wrap nav-inner">
    <a href={home} class="nav-logo">new<span>hr.ai</span></a>

    <nav class="nav-links" aria-label="sections">
      <a href={`${home}#hizmetler`}>{t.services}</a>
      <a href={`${home}#yaklasim`}>{t.approach}</a>
      <a href={`${home}#referanslar`}>{t.refs}</a>
      <a href={`${home}#hakkinda`}>{t.about}</a>
      <a href={resourcesHref}>{t.resources}</a>
      <a href={`${home}#iletisim`}>{t.contact}</a>
    </nav>

    <div class="nav-right">
      <a href={mailto(lang)} class="nav-cta">{cta}</a>
      <nav class="lang-toggle" aria-label="language">
        <a href={trHref} data-lang="tr" aria-current={lang === "tr" ? "true" : "false"}>TR</a>
        <a href={enHref} data-lang="en" aria-current={lang === "en" ? "true" : "false"}>EN</a>
      </nav>
    </div>
  </div>
</header>

<style>
  .nav {
    position: absolute;
    top: 0; left: 0; right: 0;
    z-index: 100;
    padding-block: 0.9rem;
  }

  .nav-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
  }

  .nav-logo {
    justify-self: start;
    text-decoration: none;
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--fg);
  }

  .nav-logo span { color: var(--accent-text); }

  .nav-links {
    justify-self: center;
    display: flex;
    gap: 1.6rem;
  }

  .nav-links a {
    text-decoration: none;
    color: var(--fg);
    font-size: 0.88rem;
    font-weight: 600;
  }

  .nav-links a:hover { color: var(--accent-text); }

  .nav-right {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .nav-cta {
    display: inline-flex;
    align-items: center;
    padding: 0.65rem 1.05rem;
    background: var(--btn-bg);
    color: var(--btn-fg);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 800;
    white-space: nowrap;
  }

  .lang-toggle {
    display: flex;
    border: 1.5px solid var(--line-strong);
  }

  .lang-toggle a {
    padding: 0.42rem 0.7rem;
    text-decoration: none;
    color: var(--fg);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .lang-toggle a[aria-current="true"] {
    background: var(--fg);
    color: var(--bg);
  }

  @media (max-width: 900px) {
    .nav-links { display: none; }
    .nav-inner {
      display: flex;
      justify-content: space-between;
    }
    .nav-cta { padding: 0.55rem 0.8rem; font-size: 0.78rem; }
    .nav-right { gap: 0.5rem; }
    .lang-toggle a { padding: 0.4rem 0.55rem; }
  }

  @media (max-width: 360px) {
    .nav-logo { font-size: 1.15rem; }
    .nav-cta { padding: 0.5rem 0.65rem; font-size: 0.72rem; }
  }
</style>

<script is:inline>
  document.querySelectorAll(".lang-toggle a[data-lang]").forEach(function (a) {
    a.addEventListener("click", function () {
      try {
        var l = a.getAttribute("data-lang");
        localStorage.setItem("nh_lang", l);
        // Cookie so the Netlify Edge Function on / respects the manual choice.
        document.cookie = "nh_lang=" + l + "; path=/; max-age=" + 60 * 60 * 24 * 365 + "; SameSite=Lax";
      } catch (e) {}
    });
  });
</script>
