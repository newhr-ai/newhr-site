---
import { strings, linkedin, type Lang } from "../i18n/strings";

interface Props { lang: Lang }
const { lang } = Astro.props;
const variant = "a";
const t = strings[lang].about;
const hb = t;
const stats = [
  { num: hb.stat1, label: hb.stat1Label },
  { num: hb.stat2, label: hb.stat2Label },
  { num: hb.stat3, label: hb.stat3Label },
];
const body = t.body;
const photo = "/images/Tolga_portrait_BW.jpg";
const captionSub = t.captionSub;
---

<section class={`about v-${variant}`} id="hakkinda">
  <div class="wrap grid">
    <figure class="photo">
      <img src={photo} alt={t.photoAlt} />
      <figcaption><strong>{t.photoAlt}</strong><span>{captionSub}</span></figcaption>
    </figure>
    <div class="text">
      <p class="eyebrow">{t.eyebrow}</p>
      <h2>{t.heading}</h2>
      <ul class="stats">
        {stats.map((x) => (
          <li><span class="num">{x.num}</span><span class="lbl">{x.label}</span></li>
        ))}
      </ul>
      <p class="body">{body}</p>
      <p class="trust">{t.trust}</p>

      <div class="career">
        <p class="label">{t.careerLabel}</p>
        <ul>
          {t.career.map((c) => (
            <li><strong>{c.org}</strong><span>{c.role}</span></li>
          ))}
        </ul>
        <p class="note">{t.careerNote}</p>
      </div>

      <ul class="tags">
        {t.tags.map((x) => <li>{x}</li>)}
      </ul>

      <a href={linkedin} class="textlink" target="_blank" rel="noopener noreferrer">{t.link}</a>
    </div>
  </div>
</section>

<style>
  .about { padding-block: 5rem; background: var(--bg-alt); }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 3rem;
    align-items: start;
  }

  .v-a .grid { grid-template-columns: 0.7fr 1.7fr; }

  .stats {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem 2.2rem;
    margin-top: 0.4rem;
    margin-bottom: 1.4rem;
    padding-bottom: 1.2rem;
    border-bottom: 0.5px solid var(--line);
  }

  .stats li { display: flex; flex-direction: column; gap: 0.15rem; }
  .num { font-size: 1.6rem; font-weight: 800; letter-spacing: -0.04em; line-height: 1; color: var(--accent-text); }
  .lbl { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }

  .photo { margin: 0; }

  .photo img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center top;
    filter: grayscale(1);
  }


  figcaption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.6rem;
    border-top: 2px solid var(--accent);
    font-size: 0.82rem;
  }

  .trust {
    font-size: 1.05rem;
    font-weight: 700;
    padding-left: 1rem;
    border-left: 3px solid var(--accent);
    margin-bottom: 1.8rem;
  }

  h2 { font-size: clamp(1.7rem, 3.2vw, 2.4rem); margin-bottom: 1rem; }
  .body { margin-bottom: 1.2rem; max-width: 620px; }

  .career { margin-bottom: 1.6rem; }

  .label {
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-text);
    margin-bottom: 0.6rem;
  }

  .career ul { list-style: none; display: grid; gap: 0.35rem; }

  .career li {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 1rem;
    padding: 0.5rem 0;
    border-top: 0.5px solid var(--line);
    font-size: 0.95rem;
  }

  .career li:last-child { border-bottom: 0.5px solid var(--line); }

  .note { font-size: 0.8rem; margin-top: 0.5rem; }

  .tags { list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.4rem; }

  .tags li {
    font-size: 0.78rem;
    font-weight: 700;
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--line-strong);
  }

  @media (max-width: 800px) {
    .about { padding-block: 3.5rem; }
    .grid, .v-a .grid { grid-template-columns: 1fr; gap: 1.6rem; }
    .photo { max-width: 320px; }
    .photo img { aspect-ratio: 4 / 3; object-position: center 25%; }
    .stats { gap: 1rem 1.6rem; }
    .career li { grid-template-columns: 1fr; gap: 0.2rem; }
  }
</style>
