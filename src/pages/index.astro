---
import MainLayout from "../layouts/MainLayout.astro";
import Hero from "../components/Hero.astro";
import References from "../components/References.astro";
import Services from "../components/Services.astro";
import Testimonials from "../components/Testimonials.astro";
import About from "../components/About.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";

const lang = "tr";

const meta = {
  title: "New HR AI | Yapay Zekâyı İK’nın İşine Taşıyoruz",
  description:
    "İK ekiplerinin yapay zekâ yetkinliğini eğitim, workshop ve proje danışmanlığıyla geliştiriyoruz.",
  canonical: "https://newhr.ai/",
  ogImage: "https://newhr.ai/og/newhr-ai-tr.png",
  ogImageAlt:
    "New HR AI logosu ve “Yapay zekâyı İK’nın gündeminden işine taşıyoruz” mesajı",
  locale: "tr_TR",
};
---

<MainLayout
  title={meta.title}
  lang={lang}
  description={meta.description}
  canonical={meta.canonical}
  ogImage={meta.ogImage}
  ogImageAlt={meta.ogImageAlt}
  locale={meta.locale}
>
  <Hero lang={lang} />
  <References lang={lang} />
  <Services lang={lang} />
  <Testimonials lang={lang} />
  <About lang={lang} />
  <Contact lang={lang} />
  <Footer lang={lang} />
</MainLayout>
